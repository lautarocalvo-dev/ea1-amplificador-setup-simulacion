TEXT -480 696 Left 2 !; =========================================================\n; PARÁMETROS GLOBALES\n; =========================================================\n.param Vsupply=15\n.param Rload=8.2\n.param frec=5k\n.param Vin=15m \n \n \n \n; =========================================================\n;  POLARIZACIÓN (.OP)\n; =========================================================\n;.op  \n \n; Q1 (Darlington Entrada)\n.meas OP VB_Q1 PARAM V(VB1)\n.meas OP VC_Q1 PARAM V(VCC)\n.meas OP VE_Q1 PARAM V(VE1)\n.meas OP IC_Q1 PARAM Ic(Q1)*1k\n \n; Q2 (Darlington Salida)\n.meas OP VB_Q2 PARAM V(VE1)\n.meas OP VC_Q2 PARAM V(VCC)\n.meas OP VE_Q2 PARAM V(VE2)\n.meas OP IC_Q2 PARAM Ic(Q2)*1k\n \n; Q3 (Emisor Común)\n.meas OP VB_Q3 PARAM V(VB3)\n.meas OP VC_Q3 PARAM V(VC3)\n.meas OP VE_Q3 PARAM V(VE3)\n.meas OP IC_Q3 PARAM Ic(Q3)*1k\n \n; M1 (Salida MOSFE)\n.meas OP VG_M1 PARAM V(VG1)\n.meas OP VD_M1 PARAM V(VCC)\n.meas OP VS_M1 PARAM V(VS1)\n.meas OP ID_M1 PARAM Id(M1)\n \n; =========================================================\n;  POTENCIAS (.OP)\n; =========================================================\n; --- ETAPA 1: Darlington (Q1, Q2) ---\n.meas OP P_RBin1 PARAM (V(VCC)-V(VB1))*I(RBin1)\n.meas OP P_RBin2 PARAM V(VB1)*I(RBin2)\n.meas OP P_REin  PARAM V(VE2)*I(REin)\n.meas OP P_Q1    PARAM (V(VCC)-V(VE1))*Ic(Q1)\n.meas OP P_Q2    PARAM (V(VCC)-V(VE2))*Ic(Q2)\n \n; --- ETAPA 2: Emisor Común (Q3) ---\n.meas OP P_RB1   PARAM (V(VCC)-V(VB3))*I(RB1)\n.meas OP P_RB2   PARAM V(VB3)*I(RB2)\n.meas OP P_RC    PARAM (V(VCC)-V(VC3))*I(RC1)\n.meas OP P_RE1   PARAM (V(VE3)-V(Vre2))*I(RE1)\n.meas OP P_RE2   PARAM V(Vre2)*I(RE2)\n.meas OP P_Q3    PARAM (V(VC3)-V(VE3))*Ic(Q3)\n \n; --- ETAPA 3: Etapa de Salida MOSFET (M1) ---\n.meas OP P_RB14  PARAM (V(VCC)-V(VG1))*I(RB14)\n.meas OP P_RB24  PARAM V(VG1)*I(RB24)\n.meas OP P_RE4   PARAM V(VS1)*I(RE4)\n.meas OP P_M1    PARAM (V(VCC)-V(VS1))*Id(M1)\n \n;--- Potencia de Rload(=0 porque esta desconectada por el capacitor)\n.meas OP P_RL PARAM (V(VOUT))*I(RL)\n \n; --- CONSUMO TOTAL DE CONTINUA ---\n.meas OP I_Fuente PARAM Ic(Q1)+Ic(Q2)+Ic(Q3)+Id(M1)+I(RBin1)+I(RB1)+I(RB14)\n.meas OP P_Total  PARAM Vsupply*I_Fuente\n \n \n \n; =========================================================\n; ANÁLISIS DE RESPUESTA EN FRECUENCIA (.AC) \n; (Descomentar .ac para evaluar estas mediciones)\n; =========================================================\n; Realiza un barrido desde 1 Hz hasta 100 MHz con 100 puntos por década\n;.ac dec 100 1 100Meg\n \n; Impedancias de Entrada (a 2 kHz)\n.meas AC Zin_T FIND mag(V(VIN)/I(VIN)) AT 2k\n.meas AC Zin_2 FIND mag(V(VB3)/I(Cc1)) AT 2k\n.meas AC Zin_3 FIND mag(V(VG1)/I(Cc2)) AT 2k\n; (Las Zout deben medirse alterando el circuito, apagando VIN y conectando I_test)\n \n \n; Ganancia vs Frecuencia\n.meas AC Av_1Hz FIND mag(V(VOUT)/V(VIN)) AT 1\n.meas AC Av_2Hz FIND mag(V(VOUT)/V(VIN)) AT 2\n.meas AC Av_5Hz FIND mag(V(VOUT)/V(VIN)) AT 5\n.meas AC Av_8Hz FIND mag(V(VOUT)/V(VIN)) AT 8\n.meas AC Av_10Hz FIND mag(V(VOUT)/V(VIN)) AT 10\n.meas AC Av_2KHz FIND mag(V(VOUT)/V(VIN)) AT 2k\n.meas AC Av_10KHz FIND mag(V(VOUT)/V(VIN)) AT 10k\n.meas AC Av_1MHz FIND mag(V(VOUT)/V(VIN)) AT 1Meg\n \n; Frecuencias de Corte y Ancho de Banda\n.meas AC Av_mid MAX mag(V(VOUT)/V(VIN))\n.meas AC f_low WHEN mag(V(VOUT)/V(VIN))=(Av_mid*0.707) RISE=1\n.meas AC f_high WHEN mag(V(VOUT)/V(VIN))=(Av_mid*0.707) FALL=1\n.meas AC BW PARAM f_high-f_low\n \n \n; IMPEDANCIAS DE SALIDA (.AC)\n; Requisitos previa simulación:\n; 1. En VIN: poner AC Amplitude = 0 \n; 2. Conectar fuente de corriente ITEST (AC 1) en el nodo a medir\n; 3. Comentar todas las mediciones anteriores de simulacion AC\n; 4. Descomentar SOLO la medición donde esté conectada ITEST\n;.meas AC Zout_T FIND mag(V(VOUT)/I(ITEST)) AT 2k ; (Con ITEST en nodo VOUT)\n;.meas AC Zout_1 FIND mag(V(VE2)/I(ITEST)) AT 2k    ; (Con ITEST en nodo VE2)\n;.meas AC Zout_2 FIND mag(V(VC3)/I(ITEST)) AT 2k    ; (Con ITEST en nodo VC3)\n \n \n; =========================================================\n; --- ANÁLISIS TRANSITORIO Y THD ---\n;(Para estas mediciones, f = 5 kHz en la fuente VIN)\n; =========================================================\n \n;.tran 0 5m 0 100n\n.options plotwinsize=0 numdgt=7\n.four 5k V(VE2) V(VC3) V(VOUT)\n \n;Barrido para rellenar Tablas(se debe desocmentar la linea de abajo)\n;.step param Vin LIST   2.5m 5m 10m 25m 50m 100m\n;.step param Vin LIST   17m 19.5m  98.2m\n \n; Valores Pico a Pico y Ganancia (en régimen permanente)\n.meas TRAN Vout_pp PP V(VOUT) FROM 2m TO 5m\n.meas TRAN Vin_pp PP V(VIN) FROM 2m TO 5m\n.meas TRAN Av_tran PARAM Vout_pp/Vin_pp\n \n; 1. Potencia DC promedio entregada por la fuente VCC en Regimen Permanente\n.meas TRAN PDC AVG -V(VCC)*I(V1) FROM 2m TO 5m\n \n; 2. Potencia AC promedio entregada a la carga RL\n.meas TRAN PL AVG V(VOUT)*I(RL) FROM 2m TO 5m\n \n; 3. Rendimiento del amplificador (%)\n.meas TRAN Rendimiento PARAM (PL/PDC)*100\n \n \n \n \n; =========================================================\n;  ANÁLISIS DE RUIDO (PSD) \n; =========================================================\n \n; 1. Ruido Etapa 1 (Darlington)\n;.noise V(VE2) VIN dec 50 10 100k\n \n \n; 2. Ruido Etapa 2 (Emisor Común)\n;.noise V(VC3) VIN dec 50 10 100k\n \n \n; 3. Ruido Amplificador Completo (Etapa 3 / Carga)\n;.noise V(VOUT) VIN dec 50 10 100k\n \n \n;4. Mediciones de Ruido a la salida y a la entrada\n.meas NOISE ruido_salida_rms INTEG V(onoise)\n.meas NOISE ruido_entrada_rms INTEG V(inoise)\n \n; =========================================================\n; --- BARRIDOS PARAMÉTRICOS (.STEP) ---\n;(Para Analisis de Estabilidad y Robustes del Amplificador)\n; =========================================================\n \n; 1. Sensibilidad a la Carga\n;.step param Rload LIST  0.5  5.77 8.2\n;.step param Rload LIST  6  8,2 15\n \n; 2. Sensibilidad a la Alimentación\n;.step param Vsupply LIST  1.667 11.07 14.15\n;.step param Vsupply LIST 12 15 18\n \n; 3. Sensibilidad a la Temperatura\n;.step temp LIST 25 50 75
TEXT 880 -232 Left 2 ;+15V
TEXT 864 584 Left 2 ;GND
